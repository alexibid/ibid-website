{
  "name": "ibid-website-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ibid-website/api/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "apps/ibid-website/api"
      }
    },
    "lint": {
      "executor": "nx:noop"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/ibid-website/api"
      }
    },
    "set-password": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx scripts/set-password.ts",
        "cwd": "apps/ibid-website/api"
      }
    },
    "import-pocketbase": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx scripts/import-pocketbase.ts",
        "cwd": "apps/ibid-website/api"
      }
    }
  }
}
