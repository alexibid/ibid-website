{
  "name": "ibid-website",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "website",
  "sourceRoot": "apps/ibid-website/src",
  "tags": ["type:app", "scope:ibid-website"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-app"],
      "inputs": ["production", "{projectRoot}/tools/static-css/**/*"],
      "outputs": ["{workspaceRoot}/dist/ibid-website"],
      "cache": true,
      "options": {
        "commands": [
          "node apps/ibid-website/tools/static-css/build-static-css.mjs dist/ibid-website/browser",
          "node apps/ibid-website/tools/static-css/check-size.mjs dist/ibid-website"
        ],
        "parallel": false
      }
    },
    "build-app": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "production",
      "inputs": [
        "production",
        "^production",
        {
          "runtime": "node tools/builder/hash-directories.mjs apps/ibid-website/public/pages apps/ibid-website/public/images"
        }
      ],
      "options": {
        "browser": "apps/ibid-website/src/main.ts",
        "tsConfig": "apps/ibid-website/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/ibid-website/public"
          }
        ],
        "styles": ["apps/ibid-website/src/styles.scss"],
        "server": "apps/ibid-website/src/main.server.ts",
        "outputMode": "static",
        "prerender": {
          "routesFile": "apps/ibid-website/src/prerender-routes.txt",
          "discoverRoutes": false
        },
        "allowedCommonJsDependencies": ["quill", "quill-delta"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1MB",
              "maximumError": "2MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kB",
              "maximumError": "16kB"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": { "minify": true, "inlineCritical": false },
            "fonts": true
          },
          "styles": [
            { "input": "apps/ibid-website/src/styles/layout.scss", "bundleName": "layout", "inject": false },
            {
              "input": "apps/ibid-website/src/app/ui/pages/home/home.scss",
              "bundleName": "home",
              "inject": false
            },
            {
              "input": "apps/ibid-website/src/app/ui/pages/exit/exit.scss",
              "bundleName": "exit",
              "inject": false
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/ibid-website/src/environments/environment.ts",
              "with": "apps/ibid-website/src/environments/environment.development.ts"
            },
            {
              "replace": "apps/ibid-website/src/app/app.routes.ts",
              "with": "apps/ibid-website/src/app/app.routes.development.ts"
            },
            {
              "replace": "apps/ibid-website/src/app/app.routes.server.ts",
              "with": "apps/ibid-website/src/app/app.routes.server.development.ts"
            }
          ],
          "styles": ["apps/ibid-website/src/styles.scss", "node_modules/quill/dist/quill.snow.css"]
        },
        "injected-styles": {
          "styles": ["apps/ibid-website/src/styles.scss"]
        },
        "unit-test": {
          "fileReplacements": [
            {
              "replace": "apps/ibid-website/src/environments/environment.ts",
              "with": "apps/ibid-website/src/environments/environment.development.ts"
            }
          ]
        },
        "e2e": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/ibid-website/src/environments/environment.ts",
              "with": "apps/ibid-website/src/environments/environment.e2e.ts"
            },
            {
              "replace": "apps/ibid-website/src/app/app.routes.ts",
              "with": "apps/ibid-website/src/app/app.routes.development.ts"
            },
            {
              "replace": "apps/ibid-website/src/app/app.routes.server.ts",
              "with": "apps/ibid-website/src/app/app.routes.server.development.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4200,
        "proxyConfig": "apps/ibid-website/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "ibid-website:build-app:production,injected-styles"
        },
        "development": {
          "buildTarget": "ibid-website:build-app:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "apps/ibid-website/tsconfig.spec.json",
        "buildTarget": "ibid-website:build-app:development,unit-test"
      }
    },
    "serve-e2e": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "e2e",
      "options": {
        "port": 4201
      },
      "configurations": {
        "production": {
          "buildTarget": "ibid-website:build-app:production,injected-styles"
        },
        "development": {
          "buildTarget": "ibid-website:build-app:development",
          "proxyConfig": "apps/ibid-website/proxy.conf.json"
        },
        "e2e": {
          "buildTarget": "ibid-website:build-app:e2e"
        }
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test",
        "cwd": "apps/ibid-website"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "firebase deploy --only hosting:ibid-website,functions:ibid-website --project ibid-32cbe"
      }
    }
  }
}
