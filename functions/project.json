{
  "name": "ibid-website-functions",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ibid-website/functions/src",
  "tags": ["type:app", "scope:ibid-website-functions"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "npx tsc -p tsconfig.json",
        "cwd": "apps/ibid-website/functions"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run -c vitest.config.mts",
        "cwd": "apps/ibid-website/functions"
      }
    }
  }
}
